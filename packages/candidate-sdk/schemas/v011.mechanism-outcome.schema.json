{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-self-evolving/v011.mechanism-outcome.schema.json",
  "title": "v0.1.1 trusted mechanism outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "idempotencyKey", "proposalDigest", "hypothesisDigest", "candidateDigest", "targetClusterSlug", "targetTaskHandle", "trialRefs", "targetTrials", "preservationTrials", "status", "singleTrialObservable", "label"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "idempotencyKey": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposalDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hypothesisDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "targetClusterSlug": { "type": "string", "minLength": 1, "maxLength": 80 },
    "targetTaskHandle": { "type": "string", "minLength": 1, "maxLength": 256 },
    "trialRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "targetTrials": { "type": "integer", "minimum": 0 },
    "preservationTrials": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["TARGET_IMPROVED", "TARGET_UNCHANGED", "TARGET_NOT_MEASURED", "PRESERVATION_REGRESSED", "INVALID_TRIALS"] },
    "singleTrialObservable": { "type": "boolean" },
    "label": { "const": "DEV_OBSERVED" }
  }
}
