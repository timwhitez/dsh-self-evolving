{
  "name": "@dsh-self-evolving/core",
  "version": "0.2.2",
  "type": "module",
  "description": "Trusted durable RSI controller: content-addressed object store, hash-chain journal, pure state reducer + snapshot, action saga, budget double-entry ledger. Crash-safe by construction; the filesystem is the source of truth (spec 06).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "self-evolving",
    "rsi",
    "controller",
    "journal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timwhitez/dsh-self-evolving.git",
    "directory": "packages/dsh-self-evolving"
  },
  "homepage": "https://github.com/timwhitez/dsh-self-evolving#readme",
  "bugs": {
    "url": "https://github.com/timwhitez/dsh-self-evolving/issues"
  },
  "main": "lib/index.js",
  "bin": {
    "dsh-self-evolving-status": "./lib/status-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./object-store": {
      "types": "./lib/object-store/index.d.ts",
      "default": "./lib/object-store/index.js"
    },
    "./journal": {
      "types": "./lib/journal/index.d.ts",
      "default": "./lib/journal/index.js"
    },
    "./reducer": {
      "types": "./lib/reducer/index.d.ts",
      "default": "./lib/reducer/index.js"
    },
    "./budget": {
      "types": "./lib/budget/index.d.ts",
      "default": "./lib/budget/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf lib .tsbuildinfo"
  },
  "dependencies": {
    "@dsh-self-evolving/candidate-sdk": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.10.0",
    "fastify": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
